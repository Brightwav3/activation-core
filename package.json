{
  "name": "activation-core",
  "version": "0.1.0",
  "private": true,
  "description": "Headless, provider-independent local activation infrastructure.",
  "type": "module",
  "bin": {
    "activation-core": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "decibri": "^5.5.0"
  }
}
